configuration {
    modi:                  "drun,run";
    show-icons:            true;
    display-drun:          "❯";
    display-run:           "❯";
    drun-display-format:   "{name}";
    font:                  "JetBrainsMono Nerd Font, Noto Sans Arabic 12";
}

* {
    rosewater: #f5e0dc;
    flamingo:  #f2cdcd;
    pink:      #f5c2e7;
    mauve:     #cba6f7;
    red:       #f38ba8;
    maroon:    #eba0ac;
    peach:     #fab387;
    yellow:    #f9e2af;
    green:     #a6e3a1;
    teal:      #94e2d5;
    sky:       #89dceb;
    sapphire:  #74c7ec;
    blue:      #89b4fa;
    lavender:  #b4befe;
    text:      #cdd6f4;
    subtext1:  #bac2de;
    subtext0:  #a6adc8;
    overlay2:  #9399b2;
    overlay1:  #7f849c;
    overlay0:  #6c7086;
    surface2:  #585b70;
    surface1:  #45475a;
    surface0:  #313244;
    base:      #1e1e2e;
    mantle:    #181825;
    crust:     #11111b;

    background-color: transparent;
    text-color:       var(subtext1);
}

window {
    location:          center;
    anchor:            center;
    fullscreen:        false;
    width:             600px;
    enabled:           true;
    margin:            0px;
    padding:           0px;
    border:            1px solid;
    border-radius:     10px;
    border-color:      var(surface1);
    background-color: var(base);
}

mainbox {
    enabled:           true;
    spacing:           10px;
    margin:            0px;
    padding:           14px;
    background-color: var(base);
    children:          [ "inputbar", "listview" ];
}

inputbar {
    enabled:           true;
    spacing:           10px;
    margin:            0px;
    padding:           8px 12px;
    border-radius:     8px;
    background-color: var(surface0);
    text-color:        var(subtext1);
    children:          [ "prompt", "entry" ];
}

prompt {
    enabled:           true;
    background-color: transparent;
    text-color:        var(mauve);
}

entry {
    enabled:           true;
    background-color: transparent;
    text-color:        var(subtext1);
    cursor:            text;
    placeholder:       "search...";
    placeholder-color: var(overlay0);
}

listview {
    enabled:           true;
    columns:           1;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    spacing:           4px;
    margin:            0px;
    padding:           0px;
    background-color: var(base);
    text-color:        var(subtext1);
}

element {
    enabled:           true;
    spacing:           10px;
    margin:            0px;
    padding:           7px 12px;
    border-radius:     6px;
    background-color: transparent;
    text-color:        var(subtext1);
    cursor:            pointer;
    children:          [ "element-icon", "element-text" ];
}

element-icon {
    size:              40px;
    background-color: transparent;
    cursor:            inherit;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color:        var(subtext1);
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: var(surface0);
    text-color:        var(mauve);
}

element-text {
    background-color: transparent;
    text-color:        inherit;
    highlight:         bold #cba6f7;
    cursor:            inherit;
    vertical-align:    0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:           12px;
    border-radius:     8px;
    background-color: var(base);
    text-color:        var(red);
}