{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ❯ "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;203;166;247",  // Mauve
        "at": "38;2;166;173;200",    // Subtext0
        "host": "38;2;137;180;250"   // Blue
      }
    },
    {
      "type": "custom",
      "format": "────────────"
    },
    {
      "type": "os",
      "key": "  os",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "kernel",
      "key": "󰌽  kr",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "uptime",
      "key": "󰅐  up",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "wm",
      "key": "  wm",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "shell",
      "key": "󰞷  sh",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "terminal",
      "key": "  tr",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "memory",
      "key": "󰍛  mm",
      "keyColor": "38;2;203;166;247"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}